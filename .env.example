# Copy to .env and fill in. Never commit .env.
ADMIN_PASSWORD=change-this-long-password
TOKEN_SECRET=paste-a-long-random-string
PORT=4000

# --- DATABASE ---
# Option A (Recommended for Render free tier): Set this to your Render/Neon/Supabase PostgreSQL URL.
# When set, data is PERMANENTLY stored in the cloud database and NEVER wiped on spin-down.
# DATABASE_URL=postgresql://user:password@host/dbname

# Option B (Local / SQLite): Leave DATABASE_URL unset to use a local SQLite file.
# Where the SQLite file and uploaded videos live. On a host, point this at a persistent disk.
DATA_DIR=./data
MAX_UPLOAD_MB=500
